{
  "schema_version": 1,
  "id": "019a3f10-0000-7000-8000-000000000003",
  "name": "Webhook Router",
  "description": "Classifies each webhook with a sandboxed Rhai script and routes it to the matching reply.",
  "variables": [],
  "nodes": [
    {
      "id": "hook",
      "kind": "event/on_webhook",
      "position": [
        0,
        60
      ],
      "config": {}
    },
    {
      "id": "classify",
      "kind": "code/rhai_script",
      "position": [
        272,
        60
      ],
      "config": {
        "inputs": [
          "body"
        ],
        "script": "let kind = body[\"type\"];\nif kind == \"order\" {\n    #{ route: \"orders\", message: \"Order \" + body[\"id\"] + \" received\" }\n} else if kind == \"support\" {\n    #{ route: \"support\", message: \"Support ticket \" + body[\"id\"] + \" opened\" }\n} else {\n    #{ route: \"ignored\", message: \"No route for \" + kind }\n}",
        "max_operations": 100000
      }
    },
    {
      "id": "route",
      "kind": "flow/switch",
      "position": [
        564,
        -38
      ],
      "config": {
        "cases": [
          "orders",
          "support"
        ]
      }
    },
    {
      "id": "order_reply",
      "kind": "io/send_message",
      "position": [
        908,
        8
      ],
      "config": {}
    },
    {
      "id": "support_reply",
      "kind": "io/send_message",
      "position": [
        908,
        146
      ],
      "config": {}
    },
    {
      "id": "ignored_text",
      "kind": "text/template",
      "position": [
        564,
        278
      ],
      "config": {
        "template": "Ignored webhook: {{reason}}"
      }
    },
    {
      "id": "ignored_reply",
      "kind": "io/send_message",
      "position": [
        908,
        296
      ],
      "config": {}
    }
  ],
  "wires": [
    {
      "id": "w_hook_out_classify_in",
      "from_node": "hook",
      "from_socket": "out",
      "to_node": "classify",
      "to_socket": "in"
    },
    {
